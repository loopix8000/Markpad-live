<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>markpad-live</id>
    <version>$version$</version>
    <title>Markpad Live</title>
    <authors>alecdotdev</authors>
    <description>Live Markdown editing with Milkdown.</description>
    <tags>markdown viewer tauri sveltekit editor notepad text-editor</tags>
    <projectUrl>https://github.com/loopix8000/markpad-live</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/loopix8000/markpad-live/master/src-tauri/icons/128x128.png</iconUrl>
    <licenseUrl>https://github.com/loopix8000/markpad-live/blob/master/LICENSE</licenseUrl>
    <packageSourceUrl>https://github.com/loopix8000/markpad-live/tree/master/packaging/choco</packageSourceUrl>
    <releaseNotes>https://github.com/loopix8000/markpad-live/releases</releaseNotes>
    <summary>A fast and lightweight Markdown viewer and editor</summary>
    <projectSourceUrl>https://github.com/loopix8000/markpad-live</projectSourceUrl>
    <bugTrackerUrl>https://github.com/loopix8000/markpad-live/issues</bugTrackerUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
